---
/**
 * Playground island — framework-free. All behavior lives in the processed
 * <script> below (Astro bundles it per-page, so only /playground pays for
 * it); all logic in src/playground/playground.ts. Nothing here is SSR-bound:
 * CodeMirror mounts client-side from that script, never in frontmatter.
 */
---

<div class="playground" data-playground>
  <div class="pg-toolbar">
    <strong class="pg-title" data-pg-title></strong>
    <div class="pg-options">
      <label>count <input data-pg-count type="number" min="1" placeholder="1" /></label>
      <label>seed <input data-pg-seed type="number" placeholder="random" /></label>
      <label
        >adapter
        <select data-pg-adapter>
          <option value="">auto</option>
          <option value="zod">zod</option>
          <option value="valibot">valibot</option>
        </select>
      </label>
    </div>
    <div class="pg-actions">
      <label class="pg-autorun"><input data-pg-autorun type="checkbox" checked /> auto-run</label>
      <button data-pg-run type="button" class="pg-run">▶ Run</button>
    </div>
  </div>
  <div class="pg-body">
    <nav class="pg-nav" data-pg-nav aria-label="Playground presets"></nav>
    <div class="pg-main">
      <div class="pg-editor" data-pg-editor>
        <p class="pg-editor-loading">Loading editor…</p>
      </div>
      <div class="pg-output is-idle" data-pg-output aria-live="polite"></div>
    </div>
  </div>
</div>

<style is:global>
  /* Full-width: Starlight caps .sl-container at --sl-content-width; this
   * style only ships on /playground (it's bundled with this component). */
  .sl-container:has(> [data-playground]) {
    max-width: none;
  }

  [data-playground] {
    /* Editor/output surfaces — flip with the site theme. Dark (default) is
     * Polar Night; light is Snow Storm. */
    --pg-editor-bg: var(--color-nord-1);
    --pg-editor-fg: var(--color-nord-4);
    --pg-gutter-fg: var(--color-nord-3);
    --pg-active-line: color-mix(in srgb, var(--color-nord-2) 60%, transparent);
    --pg-selection: color-mix(in srgb, var(--color-nord-10) 45%, transparent);
    --pg-syn-keyword: var(--color-nord-9);
    --pg-syn-string: var(--color-aurora-green);
    --pg-syn-literal: var(--color-aurora-purple);
    --pg-syn-property: var(--color-nord-7);
    --pg-syn-function: var(--color-nord-8);
    --pg-syn-type: var(--color-nord-7);
    --pg-syn-comment: #616e88;

    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  :root[data-theme="light"] [data-playground] {
    --pg-editor-bg: var(--color-nord-6);
    --pg-editor-fg: var(--color-nord-0);
    --pg-gutter-fg: var(--color-gray-400);
    --pg-active-line: color-mix(in srgb, var(--color-nord-5) 80%, transparent);
    --pg-selection: color-mix(in srgb, var(--color-nord-9) 30%, transparent);
    --pg-syn-keyword: var(--color-nord-10);
    --pg-syn-string: color-mix(in srgb, var(--color-aurora-green) 60%, var(--color-nord-0));
    --pg-syn-literal: color-mix(in srgb, var(--color-aurora-purple) 75%, var(--color-nord-0));
    --pg-syn-property: color-mix(in srgb, var(--color-nord-7) 60%, var(--color-nord-0));
    --pg-syn-function: var(--color-nord-10);
    --pg-syn-type: color-mix(in srgb, var(--color-nord-7) 60%, var(--color-nord-0));
    --pg-syn-comment: var(--color-gray-400);
  }

  /* ── toolbar ─────────────────────────────────────────────────────── */
  .pg-toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-sidebar);
    font-size: var(--sl-text-sm);
  }
  .pg-title {
    font-size: var(--sl-text-base);
    margin-right: auto;
  }
  .pg-options,
  .pg-actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    flex-wrap: wrap;
  }
  .pg-options label,
  .pg-autorun {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--sl-color-gray-2);
    white-space: nowrap;
  }
  .pg-options input[type="number"] {
    width: 4.5rem;
  }
  .pg-options input,
  .pg-options select {
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.375rem;
    padding: 0.25rem 0.5rem;
    font-size: var(--sl-text-sm);
  }
  .pg-run {
    background: var(--sl-color-accent);
    color: var(--sl-color-white);
    border: none;
    border-radius: 0.375rem;
    padding: 0.3rem 0.875rem;
    font-weight: 600;
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }
  .pg-run:hover {
    filter: brightness(1.15);
  }
  :root[data-theme="light"] .pg-run {
    color: var(--color-nord-6);
  }

  /* ── body: preset nav + workspace ────────────────────────────────── */
  .pg-body {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.75rem;
  }
  @media (min-width: 50rem) {
    .pg-body {
      grid-template-columns: 13rem 1fr;
      align-items: start;
    }
  }
  .pg-nav {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0.75rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background: var(--sl-color-bg-sidebar);
  }
  @media (min-width: 50rem) {
    .pg-nav {
      position: sticky;
      top: calc(var(--sl-nav-height) + 1rem);
    }
  }
  .pg-group {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
  }
  .pg-group-title {
    font-size: var(--sl-text-xs);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--sl-color-gray-3);
    padding: 0.25rem 0.5rem;
  }
  .pg-preset {
    text-align: left;
    background: none;
    border: none;
    border-radius: 0.375rem;
    padding: 0.375rem 0.5rem;
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
    cursor: pointer;
  }
  .pg-preset:hover {
    background: var(--sl-color-gray-6);
    color: var(--sl-color-white);
  }
  .pg-preset.is-active {
    background: var(--sl-color-accent-low, var(--sl-color-gray-6));
    color: var(--sl-color-accent);
    font-weight: 600;
  }
  :root[data-theme="light"] .pg-preset:hover {
    color: var(--sl-color-black);
  }

  /* ── editor over output ──────────────────────────────────────────── */
  .pg-main {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    min-width: 0;
  }
  .pg-editor {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background: var(--pg-editor-bg);
    overflow: hidden;
    min-height: 22rem;
  }
  .pg-editor .cm-editor {
    height: 100%;
  }
  .pg-editor.is-mounted .pg-editor-loading {
    display: none;
  }
  .pg-editor-loading {
    padding: 1rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .pg-output {
    border: 1px solid var(--sl-color-hairline);
    border-radius: 0.5rem;
    background: var(--pg-editor-bg);
    color: var(--pg-editor-fg);
    padding: 0.75rem 1rem;
    min-height: 8rem;
    max-height: 24rem;
    overflow: auto;
    font-size: 0.8125rem;
  }
  .pg-output pre {
    margin: 0;
    font-family: var(--sl-font-mono);
    white-space: pre-wrap;
    word-break: break-word;
    background: none;
    border: none;
    padding: 0;
  }
  .pg-output.is-idle,
  .pg-output.is-running {
    color: var(--pg-gutter-fg);
  }
  .pg-output-error-name {
    color: var(--sl-color-red);
    font-weight: 700;
    margin-bottom: 0.25rem;
  }
  .pg-output-log {
    font-family: var(--sl-font-mono);
    padding-top: 0.25rem;
    border-top: 1px solid var(--sl-color-hairline);
    margin-top: 0.25rem;
  }
  .pg-output-log.is-warn {
    color: var(--sl-color-orange);
  }
  .pg-output-log.is-error {
    color: var(--sl-color-red);
  }
</style>

<script>
  import { bootPlayground } from "../playground/playground";
  const root = document.querySelector<HTMLElement>("[data-playground]");
  if (root) bootPlayground(root);
</script>
