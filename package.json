{
  "name": "fakeborn-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter fakeborn build",
    "typecheck": "bun run --filter fakeborn typecheck",
    "test": "bun run --filter fakeborn test",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --check .",
    "format:fix": "oxfmt .",
    "check": "bun run lint && bun run format && bun run typecheck && bun run test"
  },
  "devDependencies": {
    "oxfmt": "0.54.0",
    "oxlint": "1.69.0"
  }
}
